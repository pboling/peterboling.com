---
layout: null
permalink: /feed.xml
---
<% require "cgi" %><% require "time" %><%
  escape = ->(value) { CGI.escapeHTML(value.to_s) }
  base = site.config.url.to_s.sub(%r{/$}, "")
  posts = site.collections.flat_map do |name, collection|
    next [] if name == "posts" || collection.nil?
    collection.each.reject do |post|
      post.data.exclude_from_pagination || post.data.key?("pagination") || post.data.key?("paginate")
    end
  end.uniq { |post| post.relative_url }.sort_by(&:date).reverse.first(25)
%><?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>Peter Boling | Tech Posts</title>
  <id><%== escape.call("#{base}/feed.xml") %></id>
  <link rel="self" type="application/atom+xml" href="<%== escape.call("#{base}/feed.xml") %>" />
  <link rel="alternate" type="text/html" href="<%== escape.call("#{base}/posts/") %>" />
  <updated><%== (posts.first&.date || site.time).iso8601 %></updated>
  <author><name><%== escape.call(site.data.person.name) %></name><email><%== escape.call(site.data.person.feed_email) %></email></author>
  <% posts.each do |post| %><%
    url = "#{base}#{post.relative_url}"
  %>
  <entry>
    <title><%== escape.call(post.data.title) %></title>
    <id><%== escape.call(url) %></id>
    <link rel="alternate" type="text/html" href="<%== escape.call(url) %>" />
    <updated><%== post.date.iso8601 %></updated>
    <published><%== post.date.iso8601 %></published>
    <summary><%== escape.call(post.data.excerpt || post.data.title) %></summary>
  </entry>
  <% end %>
</feed>
