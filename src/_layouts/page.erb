---
layout: default
---

<h1>
  <%= data.title %>
  <% if data.feed_url %>
    <a href="<%= data.feed_url %>" class="rss-link" title="Subscribe to <%= data.title %> feed" aria-label="Subscribe to <%= data.title %> feed">
      <img src="/images/rss.svg" alt="RSS" class="rss-icon" />
    </a>
  <% end %>
</h1>

<%= yield %>

<style>
    .posts-list {
        margin-top: 2rem;
    }

    .post-item {
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--edge-color);
    }

    .post-item:last-child {
        border-bottom: none;
    }

    .post-item h2 {
        margin: 0 0 0.5rem 0;
    }

    .post-item h2 a {
        color: var(--heading-color);
        text-decoration: none;
    }

    .post-item h2 a:hover {
        color: var(--action-color);
    }

    .post-item time {
        display: block;
        color: var(--muted);
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
    }

    .post-item p {
        color: var(--muted);
        line-height: 1.6;
    }
</style>
