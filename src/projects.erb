---
layout: page
title: Projects
page_class: projects-page
---

<%
  cards = site.data.cards.cards
  role_tags = %w[author maintainer]
  lang_tag = ->(t) { t.include?(" >= ") }
  year_tag = ->(t) { t.match?(/\A\d{4}\z/) }
  counts = Hash.new(0)
  cards.each { |c| c["tags"].each { |t| counts[t] += 1 } }
  roles = role_tags.select { |t| counts[t].positive? }
  own_tags = %w[owner releaser].select { |t| counts[t].positive? }
  ver = lambda do |t|
    v = t.split(" >= ").last.gsub(/[^\d.]/, "")
    v.empty? ? [0] : v.split(".").map(&:to_i)
  end
  langs = counts.keys.select(&lang_tag).sort_by { |t| [t.split(" >= ").first, ver.call(t)] }
  years = counts.keys.select(&year_tag).sort.reverse
  others = (counts.keys - role_tags - own_tags - langs - years).sort
  groups = [["Role", roles], ["Ownership", own_tags], ["Minimum language version", langs], ["Year started", years], ["Tags", others]].reject { |_, ts| ts.empty? }
%>

<div class="pstage">
  <img class="pstage-banner" src="/cards/banner.svg" alt="Peter Boling: team leader, web architect, security researcher, rubyist" width="880" height="200">
  <img class="pstage-city" src="/cards/city.svg" alt="Contribution city: one building per day of the last year, neon rings on the ten busiest days, a subway train along the near edge" width="880" height="470" loading="lazy">

  <p class="pstage-intro">Every project card opens that project's writing: intros, release notes and tips. Roll-ups (StructuredMerge, RuboCop-LTS) share one blog for the whole family. For the full catalogue with forges and licenses see <a href="https://galtzo.com">galtzo.com</a>.</p>

  <div class="pfilters" id="filters">
    <% groups.each do |title, tags| %>
      <details class="pfilter">
        <summary><%= title %> <span class="pf-n"><%= tags.size %></span></summary>
        <ul>
          <% tags.each do |tag| %>
            <li><button type="button" class="tag-link" data-tag="<%= tag %>"><span class="tag"><%= tag %></span> <span class="count"><%= counts[tag] %></span></button></li>
          <% end %>
        </ul>
      </details>
    <% end %>
    <button type="button" id="filter-clear" class="pf-clear" hidden>Clear filters</button>
    <span id="filter-count" class="pf-count" aria-live="polite"><%= cards.size %> projects</span>
  </div>

  <ul class="pgrid" id="pgrid">
    <% cards.each do |c| %>
      <% href, external = card_target(c) %>
      <%= render "pcard", card: c, href: href, external: external %>
    <% end %>
  </ul>
</div>
