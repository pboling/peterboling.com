#
# DO NOT EDIT THIS FILE
#
# COPT THIS FILE TO .env.local
#
# That file is ignored by .gitignore.  This file is not.
#
# Tokens used by ci:act and CI helpers for reading workflow/pipeline status via APIs
# GitHub (either GITHUB_TOKEN or GH_TOKEN will be used; fine-grained recommended)
# - Scope/permissions: For fine-grained tokens, grant repository access (Read) and Actions: Read
# - For classic tokens, public repos need no scopes; private repos typically require repo
export GITHUB_TOKEN=<your GH token for GHA status; NEVER COMMIT>
# Alternatively:
# export GH_TOKEN=<your GH token>

# GitLab (either GITLAB_TOKEN or GL_TOKEN will be used)
# - Scope: read_api is sufficient to read pipelines
export GITLAB_TOKEN=<your GitLab token for pipeline status; NEVER COMMIT>
# Alternatively:
# export GL_TOKEN=<your GitLab token>

# RubyGems.org username
export RUBYGEMS_HANDLE=<your RubyGems.org handle for publishing gems; NEVER COMMIT>

# Release Checker Syndication APIs
# Dev.to (https://dev.to/settings/account - API Keys)
export DEVTO_API_KEY=<your dev.to API key for @galtzo; NEVER COMMIT>

# Open Collective (https://opencollective.com/<org>/settings/applications - Personal Access Tokens)
export OPENCOLLECTIVE_API_KEY=<your Open Collective personal access token; NEVER COMMIT>

# RubyForum.org (Discourse - https://www.rubyforum.org/u/<username>/preferences/api)
export RUBYFORUM_API_KEY=<your RubyForum Discourse API key; NEVER COMMIT>
export RUBYFORUM_API_USERNAME=<your RubyForum username; NEVER COMMIT>

# daily.dev Squad (https://app.daily.dev/squads/rubyfriends - webhook or token)
export DAILYDEV_WEBHOOK_URL=<your daily.dev squad webhook URL; NEVER COMMIT>

# Reddit (https://www.reddit.com/prefs/apps - create a "script" app)
export REDDIT_CLIENT_ID=<your Reddit OAuth client ID; NEVER COMMIT>
export REDDIT_CLIENT_SECRET=<your Reddit OAuth client secret; NEVER COMMIT>
export REDDIT_USERNAME=<your Reddit username; NEVER COMMIT>
export REDDIT_PASSWORD=<your Reddit password; NEVER COMMIT>
